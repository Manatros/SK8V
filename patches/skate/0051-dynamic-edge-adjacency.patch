+/// SkateV: edge data for host triangles, per entity (`tag`), by the static
+/// map's rule (`skate_world::mesh_edges`, 1 mm welding). With the old 0x1e1 /
+/// -1 cosines every seam between two triangles of a ramp was a convex edge
+/// that took contacts: dropped ramps braked the board on any slope ("the
+/// slightest slope slows you down"). Host triangles stay two-sided; an edge
+/// with no neighbour keeps -1 (takes contacts, as before).
+/// Host shapes are rigid templates, so each entity's result is kept while it
+/// sends the same number of triangles (5580 triangles cost ~1.7 ms to build,
+/// and batches arrive every frame).
+fn dynamic_edges(triangles: &[([[f32; 3]; 3], u32, u32)]) -> Vec<(u32, [f32; 3])> {
+    type Edges = Vec<(u32, [f32; 3])>;
+    thread_local! {
+        static KEPT: std::cell::RefCell<std::collections::HashMap<u32, Edges>> = Default::default();
+    }
+    KEPT.with_borrow_mut(|kept| {
+        let mut seen = std::collections::HashMap::with_capacity(kept.len());
+        let out = dynamic_edges_with(triangles, |tag, count, build| {
+            let edges = match kept.remove(&tag) {
+                Some(e) if e.len() == count => e,
+                _ => build(),
+            };
+            seen.insert(tag, edges.clone());
+            edges
+        });
+        *kept = seen;
+        out
+    })
+}
+
+fn dynamic_edges_with(
+    triangles: &[([[f32; 3]; 3], u32, u32)],
+    mut entity: impl FnMut(u32, usize, &dyn Fn() -> Vec<(u32, [f32; 3])>) -> Vec<(u32, [f32; 3])>,
+) -> Vec<(u32, [f32; 3])> {
+    const BASE: u32 = 0x1e1;
+    let mut out = vec![(BASE, [-1.; 3]); triangles.len()];
+    let mut order: Vec<usize> = (0..triangles.len()).collect();
+    order.sort_by_key(|&i| triangles[i].1);
+    for group in order.chunk_by(|&a, &b| triangles[a].1 == triangles[b].1) {
+        let edges = entity(triangles[group[0]].1, group.len(), &|| entity_edges(triangles, group));
+        for (k, &i) in group.iter().enumerate() {
+            out[i] = edges[k];
+        }
+    }
+    out
+}
+
+fn entity_edges(triangles: &[([[f32; 3]; 3], u32, u32)], group: &[usize]) -> Vec<(u32, [f32; 3])> {
+    const BASE: u32 = 0x1e1;
+    let mut out = Vec::with_capacity(group.len());
+    {
+        let mut welded = std::collections::HashMap::<[i64; 3], usize>::new();
+        let mut positions = Vec::new();
+        let mut vertices = Vec::with_capacity(group.len());
+        let mut normals = Vec::with_capacity(group.len());
+        for &i in group {
+            let points = triangles[i].0;
+            vertices.push(points.map(|p| {
+                let key = p.map(|v| (f64::from(v) * 1000.0).round() as i64);
+                *welded.entry(key).or_insert_with(|| {
+                    positions.push(Vec3::from_array(p));
+                    positions.len() - 1
+                })
+            }));
+            let [a, b, c] = points.map(Vec3::from_array);
+            normals.push((b - a).cross(c - a).try_normalize().unwrap_or(Vec3::ZERO));
+        }
+        let (flags, cosines) = crate::skate_world::mesh_edges(&positions, &vertices, &normals, BASE);
+        for k in 0..group.len() {
+            let mut c = cosines[k];
+            for (edge, cosine) in c.iter_mut().enumerate() {
+                // Still convex at cosine 1: no neighbour was found.
+                if flags[k] & (0x20 << edge) != 0 && *cosine == 1. {
+                    *cosine = -1.;
+                }
+            }
+            out.push((flags[k], c));
+        }
+    }
+    out
+}
