+#[cfg(test)]
+mod dynamic_edge_tests {
+    use super::dynamic_edges;
+
+    // A 1 m quad (two triangles, diagonal 0-2) and a wall standing on its far edge.
+    const A: [f32; 3] = [0., 0., 0.];
+    const B: [f32; 3] = [1., 0., 0.];
+    const C: [f32; 3] = [1., 0., 1.];
+    const D: [f32; 3] = [0., 0., 1.];
+
+    fn edge_of(t: &[[f32; 3]; 3], p: [f32; 3], q: [f32; 3]) -> usize {
+        (0..3).find(|&e| { let (a, b) = (t[e], t[(e + 1) % 3]); (a == p && b == q) || (a == q && b == p) }).unwrap()
+    }
+
+    #[test]
+    fn a_seam_inside_a_flat_face_takes_no_edge_contact() {
+        let tris = [([A, B, C], 7, 0), ([A, C, D], 7, 0)];
+        let edges = dynamic_edges(&tris);
+        let e = edge_of(&tris[0].0, A, C);
+        assert_eq!(edges[0].0 & (0x20 << e), 0, "the diagonal is no convex edge");
+        assert_eq!(edges[0].1[e], 1.);
+        let outer = edge_of(&tris[0].0, A, B);
+        assert_ne!(edges[0].0 & (0x20 << outer), 0);
+        assert_eq!(edges[0].1[outer], -1., "an open edge keeps taking contacts");
+    }
+
+    #[test]
+    fn a_real_corner_stays_a_convex_edge() {
+        // A box's top (z = 1, facing up) meets its front (y = 0, facing -y) along C-D.
+        let tris = [([D, C, [1., 1., 1.]], 3, 0), ([A, B, C], 3, 0), ([A, C, D], 3, 0)];
+        let edges = dynamic_edges(&tris);
+        let shared = edge_of(&tris[0].0, D, C);
+        assert_ne!(edges[0].0 & (0x20 << shared), 0, "a box corner is convex");
+        assert!(edges[0].1[shared].abs() < 1e-5, "faces at 90 degrees: cosine 0, got {}", edges[0].1[shared]);
+    }
+
+    #[test]
+    fn a_moved_entity_keeps_its_edges_and_a_new_shape_is_built_anew() {
+        let moved = |dx: f32| [A, B, C, D].map(|p| [p[0] + dx, p[1], p[2]]);
+        let quad = |p: [[f32; 3]; 4]| [([p[0], p[1], p[2]], 9, 0), ([p[0], p[2], p[3]], 9, 0)];
+        let first = dynamic_edges(&quad(moved(0.)));
+        assert_eq!(dynamic_edges(&quad(moved(5.))), first);
+        // Same tag, one triangle: built for that shape, not the kept quad.
+        let single = dynamic_edges(&[([A, B, C], 9, 0)]);
+        assert!(single[0].1.iter().all(|&c| c == -1.), "{single:?}");
+    }
+
+    #[test]
+    fn different_entities_are_never_joined() {
+        let tris = [([A, B, C], 1, 0), ([A, C, D], 2, 0)];
+        let edges = dynamic_edges(&tris);
+        let e = edge_of(&tris[0].0, A, C);
+        assert_ne!(edges[0].0 & (0x20 << e), 0);
+        assert_eq!(edges[0].1[e], -1.);
+    }
+}
