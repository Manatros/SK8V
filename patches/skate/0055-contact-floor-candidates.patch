+// A scaffold supplies many nonwalkable sides but few possible supports.
+// These reference calls deliberately retain the old unfiltered candidate list.
+fn scaffold_floor_fixture() -> (Vec<WorldTriangle>, usize) {
+    let (mut triangles, source) = gap(0.25, 0.045);
+    for i in 0..4096 {
+        let x = (i % 64) as f32 * 0.02 - 0.64;
+        let z = (i / 64) as f32 * 0.02 - 0.64;
+        triangles.push(tri([[x, -1., z], [x, 2., z + 0.01], [x, -1., z + 0.01]]));
+    }
+    (triangles, source)
+}
+
+fn floor_filter_answers(triangles: &[WorldTriangle], source: usize, candidates: &[usize], bounds: &[Bounds]) -> Vec<bool> {
+    let mut answers = Vec::new();
+    for x in [-0.1, 0., 0.05, 0.25, 0.4] {
+        for y in [-0.04, 0., 0.02, 0.2] {
+            let contact = Vector3::new(x, y, 0.);
+            for normal in [Vector3::new(-1., 0., 0.), Vector3::new(-0.9, 0.3, 0.), Vector3::new(0., 1., 0.)] {
+                answers.push(imported_internal_floor_edge(source, &triangles[source], contact, normal, candidates, triangles, bounds));
+                answers.push(coplanar_gap_contact(&triangles[source], contact, normal, candidates, triangles, bounds));
+                answers.push(stacked_sheet_lip(contact, normal, candidates, triangles, bounds));
+                answers.push(wheel_scale_step(CollisionBody::Board(BodyId::RightFrontWheel), contact, contact, normal, candidates, triangles, bounds));
+                answers.push(wheel_scale_step(CollisionBody::Board(BodyId::Deck), contact, contact, normal, candidates, triangles, bounds));
+            }
+        }
+    }
+    answers
+}
