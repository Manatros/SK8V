+#[test]
+fn scaffold_floor_prefilter_preserves_all_seam_rules_and_source_order() {
+    let (triangles, source) = scaffold_floor_fixture();
+    let bounds: Vec<_> = triangles.iter().map(|t| Bounds::from_points(t.triangle.vertices).unwrap()).collect();
+    let candidates: Vec<_> = (0..triangles.len()).rev().collect();
+    let filtered = imported_floor_candidates(&candidates, &triangles);
+    assert_eq!(filtered.len(), 6);
+    assert!(filtered.windows(2).all(|w| w[0] > w[1]), "retain incoming source order");
+    let expected = floor_filter_answers(&triangles, source, &candidates, &bounds);
+    assert!(expected.iter().any(|&x| x) && expected.iter().any(|&x| !x), "exercise acceptance and rejection");
+    assert_eq!(floor_filter_answers(&triangles, source, &filtered, &bounds), expected);
+    // Threshold/NaN semantics match the existing helper comparisons exactly.
+    let mut special = triangles[..3].to_vec();
+    for (t, y) in special.iter_mut().zip([IMPORTED_SEAM_MIN_UP, IMPORTED_SEAM_MIN_UP - 0.0001, f32::NAN]) {
+        t.triangle.feature.normal.y = y;
+    }
+    assert_eq!(imported_floor_candidates(&[2, 1, 0], &special), vec![2, 0]);
+}
