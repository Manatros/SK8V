+#[test]
+#[ignore = "manual release-mode timing, no wall-clock assertions"]
+fn scaffold_floor_prefilter_timing() {
+    let (triangles, source) = scaffold_floor_fixture();
+    let bounds: Vec<_> = triangles.iter().map(|t| Bounds::from_points(t.triangle.vertices).unwrap()).collect();
+    let candidates: Vec<_> = (0..triangles.len()).collect();
+    let rounds = 50;
+    let start = std::time::Instant::now();
+    for _ in 0..rounds {
+        std::hint::black_box(floor_filter_answers(&triangles, source, std::hint::black_box(&candidates), &bounds));
+    }
+    let reference = start.elapsed();
+    let start = std::time::Instant::now();
+    for _ in 0..rounds {
+        let filtered = imported_floor_candidates(std::hint::black_box(&candidates), &triangles);
+        std::hint::black_box(floor_filter_answers(&triangles, source, &filtered, &bounds));
+    }
+    eprintln!("scaffold seam helper timing: {rounds} rounds, {} candidates, {} walkable; original {:?}, prefiltered {:?} (includes list construction)", candidates.len(), imported_floor_candidates(&candidates, &triangles).len(), reference, start.elapsed());
