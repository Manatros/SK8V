+/// Source-ordered subset shared by imported seam helpers. Their floor
+/// queries all use this exact normal gate; no possible support is removed.
+fn imported_floor_candidates(candidates: &[usize], triangles: &[WorldTriangle]) -> Vec<usize> {
+    candidates.iter().copied()
+        .filter(|&i| !(triangles[i].triangle.feature.normal.y < IMPORTED_SEAM_MIN_UP))
+        .collect()
+}
