+/// GTAxSkate 2026-11-18: wheels sank about 2.3 cm into every slope of 9 deg
+/// and more after an unpatched overlay edit lowered the lateral gate of
+/// `wheel_scale_step` from 0.5 to 0.15: a slope's own floor normal then
+/// counted as a step lip (the slope just uphill is a "walkable top"), and its
+/// contact was dropped. A plain slope must keep every floor contact.
+#[test]
+fn a_plain_slope_keeps_its_floor_contacts() {
+    for deg in [5f32, 9., 12., 20., 25.] {
+        let (s, c) = deg.to_radians().sin_cos();
+        // A plane rising toward +x at `deg`, 4 m long.
+        let p = |x: f32, z: f32| [x, x * s / c, z];
+        let w = vec![tri([p(-2., -1.), p(-2., 1.), p(2., 1.)]), tri([p(-2., -1.), p(2., 1.), p(2., -1.)])];
+        let n = [-s, c, 0.];
+        // The board point is the body's touching point (here on the slope),
+        // as Skate reports it; the wheels are the case the gate guards.
+        // Trucks and deck are kept by their own normal test and stay covered.
+        for body in [BodyId::RightFrontWheel, BodyId::LeftBackWheel, BodyId::FrontTruck, BodyId::Deck] {
+            let b = CollisionBody::Board(body);
+            assert!(!wheel_step(&w, b, [0., 0., 0.], [0., 0., 0.], n), "{deg} deg slope floor contact dropped for {body:?}");
+        }
+    }
+}
